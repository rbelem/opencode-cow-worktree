{
  "name": "opencode-cow-worktree",
  "version": "0.6.0",
  "description": "Copy-on-write worktree strategy for opencode2: a Deep clone of the whole working directory, ignored files included, so parallel agents start ready to run",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "src",
    "tui.tsx",
    "strategy-badge.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode2",
    "plugin",
    "worktree",
    "copy-on-write",
    "reflink",
    "ficlone",
    "agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^0.0.0-beta-17639",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "latest",
    "solid-js": "1.9.15",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.0.0-beta-17639"
  }
}
